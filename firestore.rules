rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isBlockedEmail() {
      return request.auth != null && request.auth.token.get('email', '') == 'zainabfatima25.g@gmail.com';
    }

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test document
    match /test/connection {
      allow read: if true;
    }

    // Recruiter User Settings (keyed by recruiter user ID)
    match /userSettings/{userId} {
      allow read, write: if !isBlockedEmail();
    }

    // Shared Staff Members & Interviewers Panel
    match /staffMembers/{staffId} {
      allow read, write: if !isBlockedEmail();
    }

    // Live Team Presence (accessible to all non-blocked team members)
    match /presence/{userId} {
      allow read, write: if !isBlockedEmail();
    }

    // Shared Candidates Pipeline (accessible to all non-blocked team members)
    match /candidates/{candidateId} {
      allow read, delete: if !isBlockedEmail();
      allow create, update: if !isBlockedEmail() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 200;
    }
  }
}

